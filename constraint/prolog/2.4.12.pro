% Komentar za studente: promenljive imaju konacne domene; ogranicenja su uslovi zadatka, a labeling pokrece pretragu resenja.
solve(Vars):- Vars=[B,P,J,M,V,N], B::0..10, P::0..20, J::0..7, M::0..5, V::0..3, N::0..9, B+P+J+M+V+N#=<10, 30*B+300*P+50*J+170*M+400*V+450*N#=<1170, 30*B+10*P+150*J+32*M+3*V+15*N#<500, 5*B+30*P+2*J+15*M+45*V+68*N#=<150, labeling([maximize(20*B+15*P+70*J+40*M+23*V+7*N)], Vars), writeln(Vars).
